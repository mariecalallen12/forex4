# Digital Utopia Platform - Environment Configuration
# Copy file này thành .env và cập nhật các giá trị
# cp .env.example .env

# ================== Application ==================
APP_NAME=Digital Utopia Platform
APP_VERSION=2.0.0
DEBUG=false
ENVIRONMENT=production

# ================== Security ==================
# IMPORTANT: Generate new key for production!
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE-THIS-IN-PRODUCTION-USE-STRONG-KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ================== PostgreSQL Database ==================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=digital_utopia
POSTGRES_PORT=5432

# ================== Redis Cache ==================
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis TTL Settings (seconds)
REDIS_SESSION_TTL=86400      # 24 hours
REDIS_CACHE_TTL=300          # 5 minutes
REDIS_RATE_LIMIT_TTL=3600    # 1 hour

# ================== Service Ports ==================
BACKEND_PORT=8000
CLIENT_PORT=3000
ADMIN_PORT=3001

# ================== CORS ==================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173

# ================== Frontend API URLs ==================
VITE_API_BASE_URL=http://localhost:8000

# ================== Email (Optional) ==================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@digitalutopia.com
EMAILS_FROM_NAME=Digital Utopia Platform

# ================== File Upload ==================
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=10485760  # 10MB

# ================== Rate Limiting ==================
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# ================== Logging ==================
LOG_LEVEL=INFO

# ================== Docker Compose ==================
COMPOSE_PROJECT_NAME=forex4
