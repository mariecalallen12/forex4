# Digital Utopia Platform - Root .gitignore

# Environment files
.env
.env.local
.env.*.local
.env.test
.env.production

# IDE and Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Docker volumes and data
data/
volumes/
backups/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build artifacts
dist/
build/
*.tar
*.tar.gz

# Test and Coverage
coverage/
htmlcov/
.coverage
*.cover
.pytest_cache/
test-report.html
.tox/

# CI/CD artifacts
*.sarif
*-report.json
bandit-report.json
safety-report.json
pip-audit-report.json
npm-audit-*.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg
venv/
env/
ENV/

# Node
node_modules/
package-lock.json

# Temporary files
tmp/
temp/
*.tmp

# OS files
Thumbs.db
.DS_Store
